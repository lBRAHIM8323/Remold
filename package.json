  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node esbuild.mjs --tests && node --test \"out-test/*.test.js\"",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --tests && node out-test/integration/run.js",
    "parity": "esbuild scripts/verify-parity.ts --bundle --platform=node --format=cjs --outfile=out-test/verify-parity.js --log-level=warning && node out-test/verify-parity.js",
    "vscode:uninstall": "node ./dist/uninstall.js"
  },
