    "configuration": {
      "title": "Remold",
      "properties": {
        "remold.fileeSource": {
          "type": "string",
          "default": "auto",
          "scope": "machine",
          "enum": [
            "auto",
            "managed",
            "installed"
          ],
          "enumDescriptions": [
            "Use your installed Filee (2.5 or later) if there is one; otherwise Remold downloads its own copy and keeps it up to date.",
            "Always use Remold's own copy of Filee (downloaded once, about 140 MB, updated automatically).",
            "Only use Filee you installed yourself; Remold downloads nothing."
          ],
          "markdownDescription": "Which Filee converts the files. `remold.fileePath` overrides this."
        },
        "remold.fileePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to a Filee command-line program to use instead (`filee`, or `filee-cli.exe` on Windows). Empty: see `remold.fileeSource`."
        },
        "remold.quality": {
          "type": "integer",
          "default": 85,
          "minimum": 1,
          "maximum": 100,
          "description": "Quality (1–100) for lossy image formats (JPG, WEBP, AVIF, …), passed to Filee."
        },
        "remold.outputFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for converted files, relative to each source file's folder (for example `converted`) or absolute. Empty puts them next to the source file. Existing files are never replaced; a number is added to the name instead."
        },
        "remold.estimateSizes": {
          "type": "boolean",
          "default": true,
          "description": "Show the size each suggested format would have in the \"More Formats…\" picker (images and vector graphics up to 25 MB). Measuring converts the file once per format in the background."
        },
        "remold.insertFormat": {
          "type": "string",
          "default": "webp",
          "markdownDescription": "Filee format id used by **Insert as … (Remold)** when dropping or pasting images into Markdown or HTML, for example `webp`, `avif`, `png` or `jpg`."
        },
        "remold.referenceFiles": {
          "type": "string",
          "default": "**/*.{html,htm,css,scss,sass,less,md,mdx,js,jsx,ts,tsx,vue,svelte,astro}",
          "markdownDescription": "Files searched for references to a converted image (glob). Empty turns off **Update References**. `node_modules`, `.git`, `dist`, `build` and `out` are always skipped."
        }
      }
    },
    "submenus": [
      {
        "id": "remold.convertSubmenu",
        "label": "Convert to"
      }
    ]
